grangertest(FTSE ~ CAC, order=10, data=df)
VARselect(df[,c("CAC","FTSE")], lag.max=10, type="const")
var_mod <- VAR(df[,c("CAC","FTSE")], lag.max=10, type="const")
var_mod2 <- VAR(df[,c("CAC","FTSE")],p=8,type="const")
causality(var_mod2, cause="CAC")$Granger
causality(var_mod2, cause="FTSE")$Granger

kmu_ss <- K[1,1]  #K^mu
kbeta_ss <- K[2,1]  #K^beta
y <- c(2.5,3.1,2.8,1.9,2.2,2.9)
year <- 2010:2015
l0 <- 2
m0 <- 0
x <- matrix(c(l0,m0),2,1)
